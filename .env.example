APP_NAME="Email Marketing System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mail.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- Database (MySQL 8) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=email_marketing
DB_USERNAME=email_marketing
DB_PASSWORD=

# --- Redis (queue + cache + rate limiter) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
# Must be larger than the longest job timeout (SendCampaignBatchJob = 300s).
REDIS_QUEUE_RETRY_AFTER=420
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local

# --- Fallback mailer (only used for system mail; campaigns use the SMTP Settings screen) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sending engine defaults (all overridable per SMTP setting / per campaign) ---
MAILING_BATCH_SIZE=50
MAILING_RATE_PER_SECOND=5
MAILING_RATE_PER_MINUTE=300
MAILING_DAILY_LIMIT=
MAILING_MAX_ATTEMPTS=3
MAILING_RETRY_DELAY=300
MAILING_STALE_SENDING_MINUTES=15
MAILING_TRASH_RETENTION_DAYS=7
MAILING_CSV_MAX_KB=51200
MAILING_CSV_CHUNK_SIZE=500

# --- Admin account created by `php artisan db:seed` ---
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
